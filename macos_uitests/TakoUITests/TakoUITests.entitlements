<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
    <array>
        <string>/private/tmp/tkui/</string>
    </array>
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/Library/Application Support/com.tako-core.terminal.uitest/</string>
        <string>/Library/Saved Application State/com.tako-core.terminal.uitest.savedState/</string>
    </array>
    <key>com.apple.security.temporary-exception.shared-preference.read-write</key>
    <array>
        <string>com.tako-core.terminal.uitest</string>
        <string>TAKO_UI_TESTS</string>
    </array>
</dict>
</plist>
