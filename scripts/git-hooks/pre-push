# Before a push that changes the Swift app, the motion gate runs on the test
# Mac (scripts/motion-gate.sh): a push that breaks an animation, an effect, a
# state or a transition of the design does not leave the machine. A change
# to the terminal view runs the iOS simulator suite as well. Once it
# passes, if what moves changed, the mutants (scripts/motion-mutants.py) run
# in the background to prove the gate still catches every broken spec item,
# and say how many they caught in a notification.
#
#   git config core.hooksPath scripts/git-hooks       # turn it on
#   git config tako.testMac user@test-mac.local       # where the gate runs (or TAKO_MAC)
#   git push --no-verify                              # skip it once
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
changed=""
while read -r _ local_sha _ remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        files=$(git log --name-only --format= "$local_sha" --not --remotes)
    else
        files=$(git diff --name-only "$remote_sha" "$local_sha")
    fi
    changed+="$files"$'\n'
done

if ! grep -qE '^swift/' <<<"$changed"; then
    exit 0
fi
TAKO_MAC="${TAKO_MAC:-$(git config --get tako.testMac || true)}"
if [ -z "$TAKO_MAC" ]; then
    echo "pre-push: the motion gate needs the test Mac: git config tako.testMac user@host (or TAKO_MAC); not run" >&2
    exit 0
fi
export TAKO_MAC
echo "pre-push: motion gate on the test Mac" >&2
scripts/motion-gate.sh

# The phone's terminal: its view, renderer and their tests run only on the
# simulator, so a change to them runs that suite too (about 70 s).
if grep -qE '^swift/(Sources/(TakoCoreUI|iOSApp)|Tests/TakoCoreUITests)/|^scripts/test-ios-surface' <<<"$changed"; then
    echo "pre-push: iOS terminal tests on the simulator" >&2
    scripts/check.sh ios
fi

# What moves: the status layers and surfaces, the strip, the sidebar, the
# Overview, the crab's rules, the cursor, and the motion tests themselves.
moving='_TakoShim/Tako\+(TabStatusLayer|Living|LiveRing|LiveActivity|Crab|TabBar|TabStrip|PaneStatus)|Features/(Sidebar|Overview)/|TakoCoreUI/(TakoTerminalNSView\+Drawing|TerminalMetalFramePlanner\+Overlays)|Tests/TakoTests/Motion/|scripts/motion-'
if grep -qE "$moving" <<<"$changed"; then
    gitdir=$(git rev-parse --git-dir)
    if [ -f "$gitdir/motion-mutants.pid" ] && kill -0 "$(cat "$gitdir/motion-mutants.pid")" 2>/dev/null; then
        echo "pre-push: mutants already running (log: $gitdir/motion-mutants.log)" >&2
    else
        nohup scripts/motion-mutants.py --notify > "$gitdir/motion-mutants.log" 2>&1 &
        echo $! > "$gitdir/motion-mutants.pid"
        echo "pre-push: mutants running in the background (log: $gitdir/motion-mutants.log)" >&2
    fi
fi
