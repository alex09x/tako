+test "awaitGuardStatus and writeAllWithTimeout enforce a single monotonic deadline under trickle I/O" {
+    const alloc = std.testing.allocator;
+
+    // 1. awaitGuardStatus under trickle Output frames expires within the single monotonic deadline.
+    {
+        const fds = try lib_posix.pipe2(.{});
+        defer lib_posix.close(fds[0]);
+        defer lib_posix.close(fds[1]);
+
+        const TrickleWriter = struct {
+            wfd: i32,
+            fn run(wfd: i32) void {
+                var empty = [0]lib_posix.pollfd{};
+                for (0..6) |_| {
+                    _ = lib_posix.poll(&empty, 15) catch {};
+                    send(wfd, .Output, "trickle-out") catch return;
+                }
+            }
+        };
+        const writer_thread = try std.Thread.spawn(.{}, TrickleWriter.run, .{fds[1]});
+        defer writer_thread.join();
+
+        var sb = try SocketBuffer.init(alloc);
+        defer sb.deinit();
+
+        const start_ms = monotonicMillis();
+        try std.testing.expectError(error.Timeout, awaitGuardStatus(fds[0], &sb, 60));
+        const elapsed_ms = monotonicMillis() - start_ms;
+        try std.testing.expect(elapsed_ms < 200);
+    }
+
+    // 2. writeAllWithTimeout under trickle reader backpressure expires within the single monotonic deadline.
+    {
+        const bp_fds = try lib_posix.pipe2(.{ .NONBLOCK = true });
+        defer lib_posix.close(bp_fds[0]);
+        defer lib_posix.close(bp_fds[1]);
+
+        const filler = [_]u8{'z'} ** 4096;
+        while (true) {
+            _ = lib_posix.write(bp_fds[1], &filler) catch |err| switch (err) {
+                error.WouldBlock => break,
+                else => return err,
+            };
+        }
+
+        const TrickleReader = struct {
+            rfd: i32,
+            fn run(rfd: i32) void {
+                var empty = [0]lib_posix.pollfd{};
+                var sink: [512]u8 = undefined;
+                for (0..5) |_| {
+                    _ = lib_posix.poll(&empty, 15) catch {};
+                    _ = lib_posix.read(rfd, &sink) catch return;
+                }
+            }
+        };
+        const reader_thread = try std.Thread.spawn(.{}, TrickleReader.run, .{bp_fds[0]});
+        defer reader_thread.join();
+
+        const large_payload = [_]u8{'A'} ** (128 * 1024);
+        const start_ms = monotonicMillis();
+        try std.testing.expectError(error.Timeout, writeAllWithTimeout(bp_fds[1], &large_payload, 60));
+        const elapsed_ms = monotonicMillis() - start_ms;
+        try std.testing.expect(elapsed_ms < 200);
+    }
+}
