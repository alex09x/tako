+    defer daemon.deinit(alloc);
+
+    const fds = try lib_posix.pipe2(.{});
+    defer lib_posix.close(fds[0]);
+    var client = Client{
+        .alloc = alloc,
+        .socket_fd = fds[1],
+        .read_buf = try ipc.SocketBuffer.init(alloc),
