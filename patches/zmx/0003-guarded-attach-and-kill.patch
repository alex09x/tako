+    try std.testing.expectEqual(@as(u8, @intFromEnum(ipc.GuardReply.Mismatch)), client.write_buf.items[@sizeOf(ipc.Header)]);
+    try std.testing.expect(daemon.labels.get("tako-attempt") == null);
+    try std.testing.expectEqualStrings("gen1", daemon.labels.get("tako-gen").?);
+    client.write_buf.clearRetainingCapacity();
