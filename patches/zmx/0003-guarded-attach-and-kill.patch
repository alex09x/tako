+    };
+    var ctx = DrainCtx{ .rfd = bp_fds[0] };
+    const thread = try std.Thread.spawn(.{}, DrainCtx.run, .{&ctx});
+    const killed = try daemon.handleKillIfLabel(alloc, &bp_client, "tako-gen=gen1");
+    thread.join();
+    try std.testing.expect(killed);
+    try std.testing.expect(ctx.matched);
+}
