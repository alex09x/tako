+/// Waits on an already-connected socket `fd` until `expected_tag` arrives or
+/// the monotonic `deadline_ms` expires. Any `.Output` frames received while
+/// waiting are preserved in `unread_output_frames` when provided (bounded by
+/// `max_unread_bytes`) or discarded for non-terminal probes (`zmx get`,
+/// `zmx set`, `zmx clear`).
+pub fn awaitExpectedTagUntilDeadlineWithBudget(
+    alloc: std.mem.Allocator,
+    fd: i32,
+    sb: *SocketBuffer,
+    expected_tag: Tag,
+    deadline_ms: i64,
+    unread_output_frames: ?*std.ArrayList(u8),
+    max_unread_bytes: usize,
+) SessionProbeError![]u8 {
+    var poll_fds = [_]lib_posix.pollfd{.{ .fd = fd, .events = lib_posix.POLL.IN, .revents = 0 }};
+    while (true) {
+        while (sb.next()) |msg| {
+            if (msg.header.tag == expected_tag) {
+                return alloc.dupe(u8, msg.payload) catch return error.Unexpected;
+            }
+            if (msg.header.tag == .Output) {
+                if (unread_output_frames) |out_list| {
+                    try appendUnreadOutputBounded(alloc, out_list, msg.payload, max_unread_bytes);
+                }
+            }
+        }
+
+        const buffered_unread = if (unread_output_frames) |out_list| out_list.items.len else 0;
+        if (buffered_unread + sb.unreadBytes() > max_unread_bytes) {
+            return error.UnreadOutputBudgetExceeded;
+        }
+
+        const remaining_i64 = deadline_ms - monotonicMillis();
+        if (remaining_i64 <= 0) return error.Timeout;
+        const wait_ms: i32 = @intCast(@min(remaining_i64, @as(i64, std.math.maxInt(i32))));
+
+        const poll_result = lib_posix.poll(&poll_fds, wait_ms) catch return error.Unexpected;
+        if (poll_result == 0) return error.Timeout;
+
+        const n = sb.read(fd) catch |err| switch (err) {
+            error.WouldBlock => continue,
+            else => return error.Unexpected,
+        };
+        if (n == 0) return error.Unexpected;
+    }
+}
