+test "closing listen socket without pathname unlink preserves replaced socket and get_session_entries is read-only" {
+    const alloc = std.testing.allocator;
+    const io = std.testing.io;
+    var dir = try std.Io.Dir.openDirAbsolute(io, "/tmp", .{});
+    defer dir.close(io);
+
+    const sub_name = "zmx-test-ro-list";
+    const sub_path = "/tmp/zmx-test-ro-list";
+    dir.deleteTree(io, sub_name) catch {};
+    try dir.createDir(io, sub_name, .default_dir);
+    defer dir.deleteTree(io, sub_name) catch {};
+
+    var sub_dir = try std.Io.Dir.openDirAbsolute(io, sub_path, .{});
+    defer sub_dir.close(io);
+
+    const sock_name = "s1";
+    const sock_path = "/tmp/zmx-test-ro-list/s1";
+
+    // 1. Daemon 1 binds sock_path, then sock_path is replaced by Daemon 2 while Daemon 1 is still alive.
+    //    When Daemon 1 exits and closes fd1 without unlinking by pathname, Daemon 2's socket remains intact and connectable.
+    const fd1 = try socket.createSocket(sock_path);
+    try sub_dir.deleteFile(io, sock_name);
+    const fd2 = try socket.createSocket(sock_path);
+    lib_posix.close(fd1);
+    try std.testing.expect(try socket.sessionExists(io, sub_dir, sock_name));
+    const cfd = try ipc.connectSession(sock_path);
+    lib_posix.close(cfd);
+
+    // 2. When Daemon 2 closes fd2 without unlinking, the stale socket returns ConnectionRefused
+    //    and get_session_entries omits the dead session without deleting the socket file on disk.
+    lib_posix.close(fd2);
+    try std.testing.expectError(error.ConnectionRefused, ipc.connectSession(sock_path));
+    var entries = try util.get_session_entries(alloc, io, sub_path);
+    defer {
+        for (entries.items) |e| e.deinit(alloc);
+        entries.deinit(alloc);
+    }
+    try std.testing.expectEqual(@as(usize, 0), entries.items.len);
+    try std.testing.expect(try socket.sessionExists(io, sub_dir, sock_name));
+}
