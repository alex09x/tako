+fn appendUnreadOutputBounded(
+    alloc: std.mem.Allocator,
+    out_list: *std.ArrayList(u8),
+    payload: []const u8,
+    max_bytes: usize,
+) SessionProbeError!void {
+    const frame_len = @sizeOf(Header) + payload.len;
+    if (out_list.items.len + frame_len > max_bytes) {
