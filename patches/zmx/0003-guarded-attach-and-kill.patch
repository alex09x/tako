+/// Performs a single-socket guarded attach handshake on `fd`, preserving any
+/// `.Output` frames received during the handshake so nothing is lost before
+/// `clientLoopWithUnread` starts.
+///
+/// When `allow_legacy_fallback` is true (`zmx attach --attach-only --if-label ...`),
+/// pipelines `.AttachIfLabel` followed by `.LabelGet` on `fd`:
+/// - A new daemon processes `.AttachIfLabel` first and replies with `.GuardStatus`
+///   before `.LabelData`. A `.Mismatch` or `.Invalid` reply fails closed immediately
+///   and never falls back to legacy.
+/// - An older `0.8.x` daemon ignores `.AttachIfLabel` and replies immediately with
+///   `.LabelData`. On that same connected socket `fd`, the client verifies
+///   `required_labels`, re-verifies `required_labels` via a second `.LabelGet` on
+///   `fd`, and (if `set_labels` is non-empty) sends `.LabelSet` and awaits `.Ack`
+///   before returning the preserved unread `.Output` stream.
+pub fn performGuardedOrLegacyAttachHandshake(
+    alloc: std.mem.Allocator,
+    fd: i32,
+    required_labels: []const u8,
+    set_labels: ?[]const u8,
+    allow_legacy_fallback: bool,
+    timeout_ms: i32,
+    legacy_after_probe_delay_ms: u32,
+) AttachHandshakeError![]u8 {
+    return performGuardedOrLegacyAttachHandshakeWithOptions(
+        alloc,
+        fd,
+        required_labels,
+        set_labels,
+        allow_legacy_fallback,
+        timeout_ms,
+        .{ .after_probe_delay_ms = legacy_after_probe_delay_ms },
+    );
+}
