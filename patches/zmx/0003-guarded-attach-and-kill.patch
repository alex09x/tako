+    // 2. Empty required generation on AttachIfLabel is rejected as Invalid.
+    try daemon.handleAttachIfLabel(alloc, &client, "\ntako-attempt=att1");
+    try std.testing.expectEqual(@as(u8, @intFromEnum(ipc.GuardReply.Invalid)), client.write_buf.items[@sizeOf(ipc.Header)]);
+    try std.testing.expect(daemon.labels.get("tako-attempt") == null);
+    client.write_buf.clearRetainingCapacity();
+
+    // 3. Matching generation on AttachIfLabel atomically sets `tako-attempt=att1` and replies Matched.
+    try daemon.handleAttachIfLabel(alloc, &client, "tako-gen=gen1\ntako-attempt=att1");
+    try std.testing.expectEqual(@as(u8, @intFromEnum(ipc.GuardReply.Matched)), client.write_buf.items[@sizeOf(ipc.Header)]);
