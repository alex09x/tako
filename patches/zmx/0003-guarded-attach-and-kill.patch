+pub const GuardLabelError = error{
+    EmptyLabels,
+    MalformedPair,
+    EmptyValue,
+} || LabelError;
+
+/// Strictly validates space-separated `key=value` pairs.
+/// Rejects empty strings when `require_non_empty` is true, leading/trailing/double
+/// spaces, tokens without `=`, duplicate keys, reserved keys, and invalid characters.
+/// When `require_values` is true, also rejects empty values (`key=`).
+pub fn validateLabelPairs(
+    raw: []const u8,
+    require_non_empty: bool,
+    require_values: bool,
+) GuardLabelError!void {
+    if (raw.len == 0) {
+        if (require_non_empty) return error.EmptyLabels;
+        return;
+    }
+    var count: usize = 0;
+    var start: usize = 0;
+    while (start <= raw.len) {
+        const end = std.mem.indexOfScalarPos(u8, raw, start, ' ') orelse raw.len;
+        const token = raw[start..end];
+        if (token.len == 0) return error.MalformedPair;
+        const eq = std.mem.indexOfScalar(u8, token, '=') orelse return error.MalformedPair;
+        const key = token[0..eq];
+        const value = token[eq + 1 ..];
+        try assertLabel(key, value);
+        if (require_values and value.len == 0) return error.EmptyValue;
+
+        var prev_start: usize = 0;
+        while (prev_start < start) {
+            const prev_end = std.mem.indexOfScalarPos(u8, raw, prev_start, ' ') orelse start;
+            const prev_tok = raw[prev_start..prev_end];
+            if (std.mem.indexOfScalar(u8, prev_tok, '=')) |prev_eq| {
+                if (std.mem.eql(u8, prev_tok[0..prev_eq], key)) return error.MalformedPair;
+            }
+            prev_start = prev_end + 1;
+        }
+
+        count += 1;
+        if (end == raw.len) break;
+        start = end + 1;
+    }
+    if (require_non_empty and count == 0) return error.EmptyLabels;
+}
+
+/// Returns true iff `required` is a valid non-empty `key=value` list (with non-empty
+/// values) and every pair in `required` matches `actual` exactly.
+pub fn labelsMatch(actual: std.StringHashMapUnmanaged([]u8), required: []const u8) bool {
+    validateLabelPairs(required, true, true) catch return false;
+    var start: usize = 0;
+    while (start <= required.len) {
+        const end = std.mem.indexOfScalarPos(u8, required, start, ' ') orelse required.len;
+        const token = required[start..end];
+        const eq = std.mem.indexOfScalar(u8, token, '=') orelse return false;
+        const key = token[0..eq];
+        const expected_val = token[eq + 1 ..];
+        const actual_val = actual.get(key) orelse return false;
+        if (!std.mem.eql(u8, actual_val, expected_val)) return false;
+        if (end == required.len) break;
+        start = end + 1;
+    }
+    return true;
+}
+
+/// Returns true iff `required` is a valid non-empty `key=value` list (with non-empty
+/// values) and every pair in `required` matches the space-separated `actual_pairs`
+/// (`Tag.LabelData` wire payload) exactly.
+pub fn labelPairsMatch(actual_pairs: []const u8, required: []const u8) bool {
+    validateLabelPairs(required, true, true) catch return false;
+    validateLabelPairs(actual_pairs, false, true) catch return false;
+    var start: usize = 0;
+    while (start <= required.len) {
+        const end = std.mem.indexOfScalarPos(u8, required, start, ' ') orelse required.len;
+        const token = required[start..end];
+        const eq = std.mem.indexOfScalar(u8, token, '=') orelse return false;
+        const key = token[0..eq];
+        const expected_val = token[eq + 1 ..];
+        const actual_val = getLabelValueFromPairs(key, actual_pairs) catch return false;
+        if (!std.mem.eql(u8, actual_val, expected_val)) return false;
+        if (end == required.len) break;
+        start = end + 1;
+    }
+    return true;
+}
+
+test "validateLabelPairs and labelsMatch reject empty, malformed, and mismatched labels" {
+    const alloc = std.testing.allocator;
+    try std.testing.expectError(error.EmptyLabels, validateLabelPairs("", true, true));
+    try std.testing.expectError(error.MalformedPair, validateLabelPairs("tako-gen", true, true));
+    try std.testing.expectError(error.EmptyValue, validateLabelPairs("tako-gen=", true, true));
+    try std.testing.expectError(error.MalformedPair, validateLabelPairs("tako-gen=a bogus", true, true));
+    try std.testing.expectError(error.MalformedPair, validateLabelPairs("tako-gen=a tako-gen=a", true, true));
+    try std.testing.expectError(error.MalformedPair, validateLabelPairs("tako-gen=a ", true, true));
+    try validateLabelPairs("tako-gen=gen1 tako-attempt=att1", true, true);
+
+    var map = std.StringHashMapUnmanaged([]u8).empty;
+    defer map.deinit(alloc);
+    try map.put(alloc, @constCast("tako-gen"), @constCast("gen1"));
+    try map.put(alloc, @constCast("role"), @constCast("worker"));
+
+    try std.testing.expect(labelsMatch(map, "tako-gen=gen1"));
+    try std.testing.expect(labelsMatch(map, "tako-gen=gen1 role=worker"));
+    try std.testing.expect(!labelsMatch(map, ""));
+    try std.testing.expect(!labelsMatch(map, "tako-gen"));
+    try std.testing.expect(!labelsMatch(map, "tako-gen=gen2"));
+    try std.testing.expect(!labelsMatch(map, "tako-gen=gen1 role=other"));
+    try std.testing.expect(!labelsMatch(map, "tako-gen=gen1 missing=1"));
+
+    try std.testing.expect(labelPairsMatch("role=worker tako-gen=gen1", "tako-gen=gen1"));
+    try std.testing.expect(labelPairsMatch("role=worker tako-gen=gen1", "tako-gen=gen1 role=worker"));
+    try std.testing.expect(!labelPairsMatch("", "tako-gen=gen1"));
+    try std.testing.expect(!labelPairsMatch("role=worker tako-gen=gen1", "tako-gen=gen2"));
+    try std.testing.expect(!labelPairsMatch("role=worker tako-gen=gen1", ""));
+}
