+    try std.testing.expectError(error.Timeout, ipc.writeAllWithTimeout(bp_fds[1], "ack", 20));
+
+    const DrainCtx = struct {
+        rfd: i32,
+        matched: bool = false,
+        fn run(ctx: *@This()) void {
+            var rsb = ipc.SocketBuffer.init(std.heap.page_allocator) catch return;
+            defer rsb.deinit();
+            const reply = ipc.awaitGuardStatus(ctx.rfd, &rsb, 1000) catch return;
