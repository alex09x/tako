+/// Writes all bytes of `data` to `fd` within a single overall monotonic
+/// `timeout_ms` deadline, polling for `POLL.OUT` whenever a non-blocking
+/// descriptor returns `error.WouldBlock` or performs a partial write.
+pub fn writeAllWithTimeout(
+    fd: i32,
+    data: []const u8,
+    timeout_ms: i32,
+) SessionProbeError!void {
+    const deadline_ms = monotonicMillis() + @as(i64, @max(timeout_ms, 0));
+    var written: usize = 0;
+    var poll_fds = [_]lib_posix.pollfd{.{ .fd = fd, .events = lib_posix.POLL.OUT, .revents = 0 }};
+    while (written < data.len) {
+        const n = lib_posix.write(fd, data[written..]) catch |err| switch (err) {
+            error.WouldBlock => blk: {
+                const remaining_i64 = deadline_ms - monotonicMillis();
+                if (remaining_i64 <= 0) return error.Timeout;
+                const wait_ms: i32 = @intCast(@min(remaining_i64, @as(i64, std.math.maxInt(i32))));
+                const poll_result = lib_posix.poll(&poll_fds, wait_ms) catch return error.Unexpected;
+                if (poll_result == 0) return error.Timeout;
+                if (poll_fds[0].revents & (lib_posix.POLL.ERR | lib_posix.POLL.HUP | lib_posix.POLL.NVAL) != 0) {
+                    return error.Unexpected;
+                }
+                break :blk @as(usize, 0);
+            },
+            else => return error.Unexpected,
+        };
+        written += n;
+        if (written < data.len and monotonicMillis() >= deadline_ms) {
+            return error.Timeout;
         }
     }
-    return error.Unexpected;
+}
