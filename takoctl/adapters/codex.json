{
  "name": "codex",
  "title": "Codex CLI",
  "aliases": [
    "opencode"
  ],
  "config_path": "~/.codex/hooks.json",
  "format": "json",
  "hook_field": "hooks",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v tako-hook >/dev/null 2>&1; then tako-hook codex user_prompt_submit; else /Users/alex09x/.local/bin/tako-hook codex user_prompt_submit; fi; :",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v tako-hook >/dev/null 2>&1; then tako-hook codex stop; else /Users/alex09x/.local/bin/tako-hook codex stop; fi; :",
            "timeout": 5
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v tako-hook >/dev/null 2>&1; then tako-hook codex interrupt; else /Users/alex09x/.local/bin/tako-hook codex interrupt; fi; :",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v tako-hook >/dev/null 2>&1; then tako-hook codex permission_request; else /Users/alex09x/.local/bin/tako-hook codex permission_request; fi; :",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alex09x/.local/bin/tako-hook codex question",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/alex09x/.local/bin/tako-hook codex question_answered",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
